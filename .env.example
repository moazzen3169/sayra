# ==============================================================================
# SAYRA / PLAYNEST ENVIRONMENT CONFIGURATION
# ==============================================================================

# Upstream Backend API Base URL (Server-side proxy target)
# Do not expose secrets or API keys in client-side NEXT_PUBLIC_ variables.
API_BASE_URL=http://87.248.156.152/api/v1

# Server-Side Application API Key (Injected by /api/proxy into x-api-key header)
# Resolution priority:
# 1. SAYRA_API_KEY
# 2. PLAYNEST_API_KEY
# 3. STATIC_API_KEY
# NOTE: This key is strictly server-side and must never be exposed to the browser.
SAYRA_API_KEY=
PLAYNEST_API_KEY=
STATIC_API_KEY=

# Application Timezone
NEXT_PUBLIC_APP_TIME_ZONE=Asia/Tehran

# Mock Mode Configuration (Production strictly disables mock by default)
# NEXT_PUBLIC_USE_MOCK=false
